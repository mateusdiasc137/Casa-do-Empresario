<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="0" android:startColor="#3321D6A3" android:endColor="#2AD6B45A" />
            <stroke android:width="1dp" android:color="#8821D6A3" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="@color/cev_surface_2" android:endColor="@color/cev_surface_3" />
            <stroke android:width="1dp" android:color="@color/outline" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
