<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="38dp"
        android:layout_height="38dp"
        app:cardBackgroundColor="@color/cev_surface"
        app:cardCornerRadius="19dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/cev_gold_border"
        app:strokeWidth="1dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Mascote do CapiHub"
            android:scaleType="centerCrop"
            android:src="@drawable/toolbar_capihub_mascot" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:letterSpacing="0.02"
        android:text="CapiHub"
        android:textColor="@color/cev_gold"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
