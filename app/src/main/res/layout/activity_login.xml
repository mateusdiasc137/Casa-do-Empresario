<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_premium"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="46dp"
        android:paddingBottom="28dp">

        <FrameLayout
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/ringOuter"
                android:layout_width="176dp"
                android:layout_height="176dp"
                android:layout_gravity="center"
                android:background="@drawable/ring_outer" />

            <ImageView
                android:id="@+id/ringInner"
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:layout_gravity="center"
                android:background="@drawable/ring_inner" />

            <LinearLayout
                android:id="@+id/logo_core"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_logo"
                android:elevation="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="CEV"
                    android:textColor="@color/cev_gold_light"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="5dp"
                    android:background="@color/cev_gold" />
            </LinearLayout>

            <View
                android:id="@+id/pulseDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="7dp"
                android:background="@drawable/dot_gold" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:letterSpacing="0.34"
            android:text="CASA DO EMPRESÁRIO"
            android:textColor="@color/cev_gold"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="Eventos de Viçosa"
            android:textColor="@color/cev_text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:text="Conecte empresas, organizadores e participantes em uma experiência mais simples e elegante."
            android:textColor="@color/cev_text_muted"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:cardBackgroundColor="@color/cev_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/cev_gold_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entrar na plataforma"
                    android:textColor="@color/cev_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"
                    android:text="Use seu e-mail e senha para acessar sua agenda."
                    android:textColor="@color/cev_text_muted"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.CasaEmpresario.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="E-mail"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:startIconDrawable="@android:drawable/ic_dialog_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/cev_text_primary"
                        android:textColorHint="@color/cev_text_muted" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.CasaEmpresario.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Senha"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:passwordToggleEnabled="true"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_senha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:textColor="@color/cev_text_primary"
                        android:textColorHint="@color/cev_text_muted" />
                </com.google.android.material.textfield.TextInputLayout>

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    android:indeterminateTint="@color/cev_gold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_entrar"
                    style="@style/Widget.CasaEmpresario.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.12"
                    android:text="ENTRAR"
                    android:textColor="@color/cev_background"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/cev_gold"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cadastrar"
                    style="@style/Widget.CasaEmpresario.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:text="Criar uma conta"
                    android:textColor="@color/cev_gold"
                    app:rippleColor="#22D6B45A" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_explorar_sem_login"
                    style="@style/Widget.CasaEmpresario.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:text="Explorar sem login"
                    android:textColor="@color/secondary"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/secondary"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="© 2026 Casa do Empresário de Viçosa"
            android:textColor="@color/cev_dot_dark"
            android:textSize="10sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
