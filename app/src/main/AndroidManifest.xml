<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Acesso a imagens da galeria -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Notificações -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Localização e mapas -->

    <permission
        android:name="com.casaempresario.permission.MAPS_RECEIVE"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.casaempresario.permission.MAPS_RECEIVE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="false" />

    <application
        android:name=".CasaEmpresarioApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CasaEmpresario">

        <!-- Configuração do Google Maps -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <meta-data
            android:name="com.google.android.maps.v2.API_KEY"
            android:value="${mapsApiKey}"/>

        <!-- Tela inicial -->
        <activity
            android:name=".activity.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Cadastro -->
        <activity
            android:name=".activity.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".activity.LoginActivity" />

        <!-- Tela principal -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="false" />

        <!-- Experiências complementares de produto -->
        <activity
            android:name=".activity.OrganizerDashboardActivity"
            android:exported="false"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.NotificationCenterActivity"
            android:exported="false"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.ProfileDetailsActivity"
            android:exported="false"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".activity.ProfileDetailsActivity" />


        <!-- Detalhes do evento -->
        <activity
            android:name=".activity.EventDetailActivity"
            android:exported="false"
            android:parentActivityName=".activity.MainActivity" />

        <!-- Visualização de fotos -->
        <activity
            android:name=".activity.PhotoPostActivity"
            android:exported="false"
            android:parentActivityName=".activity.EventDetailActivity" />

        <!-- Criação e edição de eventos -->
        <activity
            android:name=".activity.CreateEventActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".activity.MainActivity" />

        <!-- Mapa de eventos -->
        <activity
            android:name=".activity.MapActivity"
            android:exported="false"
            android:parentActivityName=".activity.MainActivity" />

        <!-- Seleção de localização -->
        <activity
            android:name=".activity.LocationPickerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".activity.CreateEventActivity" />

        <!-- Chat e mensagens -->
        <activity
            android:name=".activity.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".activity.MainActivity" />

        <!-- Verificação periódica de novidades -->
        <receiver
            android:name=".receiver.NotificationCheckReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Mantém as verificações após reinicialização -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Serviço de notificações de eventos -->
        <service
            android:name=".service.EventNotificationService"
            android:enabled="true"
            android:exported="false" />

        <!-- Serviço FCM para notificações push -->
        <service
            android:name=".service.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
